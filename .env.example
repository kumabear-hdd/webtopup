# ====================================================================
# KUMAGEMU — ENVIRONMENT CONFIGURATION (.env.example)
# ====================================================================
# CATATAN PENGEMBANGAN GRATIS (FREE DEVELOPMENT / PREVIEW):
# Untuk menjalankan preview dan pengembangan gratis, Anda TIDAK PERLU
# mengisi API key Digiflazz maupun Midtrans. Aplikasi secara otomatis
# berjalan dalam Sandbox Mock Mode (100% gratis, aman, tanpa API key).
# ====================================================================

# AI Studio runtime secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Admin Console Security Passcode (Demo: kuma2026)
ADMIN_PASSCODE="kuma2026"

# --------------------------------------------------------------------
# 1. SUPPLIER INTEGRATION (DIGIFLAZZ)
# --------------------------------------------------------------------
# SUPPLIER_MODE: "mock" (default, free dev) | "digiflazz" (live supplier)
# Dalam mode "mock", kredensial di bawah TIDAK DIPERLUKAN dan diabaikan.
SUPPLIER_MODE="mock"

# Kredensial Resmi Digiflazz (Hanya dibutuhkan jika SUPPLIER_MODE="digiflazz")
# Backend membaca DIGIFLAZZ_USER atau DIGIFLAZZ_USERNAME secara fleksibel.
# Server-side only: TIDAK PERNAH dikirim atau dibocorkan ke browser.
DIGIFLAZZ_USERNAME=""
DIGIFLAZZ_API_KEY=""
DIGIFLAZZ_WEBHOOK_SECRET=""

# --------------------------------------------------------------------
# 2. PAYMENT GATEWAY INTEGRATION (MIDTRANS)
# --------------------------------------------------------------------
# PAYMENT_GATEWAY_MODE: "mock" (default, free dev) | "midtrans" (live payment)
# Dalam mode "mock", kredensial di bawah TIDAK DIPERLUKAN dan diabaikan.
PAYMENT_GATEWAY_MODE="mock"

# Kredensial Resmi Midtrans (Hanya dibutuhkan jika PAYMENT_GATEWAY_MODE="midtrans")
# Server-side only: TIDAK PERNAH dikirim atau dibocorkan ke browser.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
